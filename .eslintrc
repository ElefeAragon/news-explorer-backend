{
  "extends": "airbnb-base",
  "env": {
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_id"] }]
  },
  "overrides": [
    {
      "files": ["utils/errors.js"],
      "rules": {
        "max-classes-per-file": ["error", 6]
      }
    }
  ]
}
